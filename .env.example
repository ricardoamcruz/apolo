# A.P.O.L.O. — exemplo de variáveis de ambiente
# ===================================================================
# Copie para .env.local e preencha. Nunca commite uma chave de verdade.
#
# Este arquivo é lido pela ponte (bridge/server.mjs), por quem sobe o sistema
# (npm start, npm run rollback) e pelo Vite. Só o que começa com VITE_ chega ao
# navegador — as chaves abaixo ficam na ponte.
#
# Variáveis definidas no terminal têm prioridade sobre este arquivo.


# ===================================================================
# VOZ EM TEMPO REAL (speech-to-speech) — ADR 0009 e 0010
# ===================================================================
# Provedor: gemini (padrão, tem plano gratuito) ou openai (pago por uso).
# Sem valor: usa o Gemini se houver GEMINI_API_KEY, senão a OpenAI.
# APOLO_VOZ_PROVEDOR=gemini

# --- Gemini Live -----------------------------------------------------
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo: gemini-3.8-live (padrão, baixa latência).
# APOLO_GEMINI_MODELO=gemini-3.8-live

# Voz: Charon (padrão), Orus e Fenrir são graves; Kore, Aoede, Leda, agudas.
# APOLO_GEMINI_VOZ=Charon

# --- OpenAI Realtime ---------------------------------------------------
# Chave: https://platform.openai.com/api-keys (exige créditos).
# OPENAI_API_KEY=

# Modelo: gpt-realtime-2.1 ou gpt-realtime-2.1-mini (cerca de um terço do custo).
# APOLO_REALTIME_MODELO=gpt-realtime-2.1

# Voz: cedar (padrão) ou ash são graves; marin, coral, shimmer, agudas.
# APOLO_REALTIME_VOZ=cedar

# Raciocínio antes de falar: minimal, low (padrão), medium, high.
# APOLO_REALTIME_RACIOCINIO=low

# Modelo que transcreve a sua fala para o histórico na tela.
# APOLO_REALTIME_TRANSCRICAO=gpt-4o-mini-transcribe

# --- Ambos ---------------------------------------------------------------
# Silêncio (ms) que encerra a sua vez de falar. Menor responde mais rápido.
# APOLO_REALTIME_SILENCIO_MS=500


# ===================================================================
# AGENTE DE TAREFAS (Claude) — usa o login do Claude Code, sem chave
# ===================================================================
# Porta da ponte. Se mudar, mude VITE_BRIDGE_URL junto.
# JARVIS_BRIDGE_PORT=8787

# Modelo do agente de tarefas e esforço.
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high

# Liberar ações com efeito (enviar, clicar, apagar, pagar). Desligado por
# padrão. `npm start -- --writes` liga só para aquela execução.
# JARVIS_ALLOW_WRITES=0

# Outras origens do navegador aceitas pela ponte, separadas por vírgula.
# JARVIS_ALLOWED_ORIGINS=

# Aceitar clientes sem cabeçalho Origin (curl, scripts, app nativo). Padrão 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Pastas extras que o endpoint /file pode servir, separadas por vírgula.
# JARVIS_FILE_ROOTS=


# ===================================================================
# AUTODESENVOLVIMENTO — ADR 0011 (desligado por padrão)
# ===================================================================
# Permite ao A.P.O.L.O. alterar o próprio código quando você pedir e confirmar.
# `npm start -- --autodev` liga só para aquela execução.
# APOLO_AUTODEV=0

# Modelo, esforço e limites do agente que altera o código.
# APOLO_AUTODEV_MODELO=claude-opus-5
# APOLO_AUTODEV_ESFORCO=high
# APOLO_AUTODEV_TURNOS=80
# APOLO_AUTODEV_ORCAMENTO_USD=10
# APOLO_AUTODEV_LIMITE_MIN=30

# Abrir a cópia de trabalho no VS Code, numa instância própria. 1 liga.
# APOLO_AUTODEV_VSCODE=1
# Fase usada no nome da branch quando o agente não indicar outra.
# APOLO_AUTODEV_FASE=2.2
# APOLO_VSCODE_BIN=

# Onde ficam as cópias de trabalho e o histórico. Padrão: ~/.apolo/autodev
# APOLO_AUTODEV_PASTA=


# ===================================================================
# INTERFACE (Vite)
# ===================================================================
# Onde a ponte escuta.
# VITE_BRIDGE_URL=ws://localhost:8787
