# A.P.O.L.O. — exemplo de variáveis de ambiente
# ===================================================================
# Copie para .env.local e preencha. Nunca commite uma chave de verdade.
#
# Este arquivo é lido pela ponte (bridge/server.mjs), pela F.Ê.N.I.X. (npm start,
# npm run rollback), que o repassa ao H.E.R.M.E.S., e pelo Vite. Só o que começa com VITE_ chega ao
# navegador — as chaves abaixo ficam na ponte.
#
# Variáveis definidas no terminal têm prioridade sobre este arquivo.


# ===================================================================
# VOZ EM TEMPO REAL (speech-to-speech) — ADR 0009 e 0010
# ===================================================================
# Provedor: gemini (padrão, tem plano gratuito) ou openai (pago por uso).
# Sem valor: usa o Gemini se houver GEMINI_API_KEY, senão a OpenAI.
# APOLO_VOZ_PROVEDOR=gemini

# --- Gemini Live -----------------------------------------------------
# Chave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo: gemini-3.8-live (padrão, baixa latência).
# APOLO_GEMINI_MODELO=gemini-3.8-live

# Voz: Charon (padrão), Orus e Fenrir são graves; Kore, Aoede, Leda, agudas.
# APOLO_GEMINI_VOZ=Charon

# --- OpenAI Realtime ---------------------------------------------------
# Chave: https://platform.openai.com/api-keys (exige créditos).
# OPENAI_API_KEY=

# Modelo: gpt-realtime-2.1 ou gpt-realtime-2.1-mini (cerca de um terço do custo).
# APOLO_REALTIME_MODELO=gpt-realtime-2.1

# Voz: cedar (padrão) ou ash são graves; marin, coral, shimmer, agudas.
# APOLO_REALTIME_VOZ=cedar

# Raciocínio antes de falar: minimal, low (padrão), medium, high.
# APOLO_REALTIME_RACIOCINIO=low

# Modelo que transcreve a sua fala para o histórico na tela.
# APOLO_REALTIME_TRANSCRICAO=gpt-4o-mini-transcribe

# --- Ambos ---------------------------------------------------------------
# Silêncio (ms) que encerra a sua vez de falar. Menor responde mais rápido.
# APOLO_REALTIME_SILENCIO_MS=1200


# ===================================================================
# AGENTE DE TAREFAS (Claude) — usa o login do Claude Code, sem chave
# ===================================================================
# Porta da ponte. Se mudar, mude VITE_BRIDGE_URL junto.
# JARVIS_BRIDGE_PORT=8787

# Modelo do agente de tarefas e esforço.
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high

# Liberar ações com efeito (enviar, clicar, apagar, pagar). Desligado por
# padrão. `npm start -- --writes` liga só para aquela execução.
# JARVIS_ALLOW_WRITES=0

# Outras origens do navegador aceitas pela ponte, separadas por vírgula.
# JARVIS_ALLOWED_ORIGINS=

# Aceitar clientes sem cabeçalho Origin (curl, scripts, app nativo). Padrão 0.
# JARVIS_ALLOW_NO_ORIGIN=0

# Pastas extras que o endpoint /file pode servir, separadas por vírgula.
# JARVIS_FILE_ROOTS=

# Servidores MCP do Claude Code (~/.claude.json) que o A.P.O.L.O. não deve
# carregar, separados por vírgula. Continuam no Claude Code (ADR 0018).
# APOLO_MCP_IGNORAR=


# ===================================================================
# AUTODESENVOLVIMENTO — ADR 0011 (desligado por padrão)
# ===================================================================
# Permite ao A.P.O.L.O. alterar o próprio código quando você pedir e confirmar.
# `npm start -- --autodev` liga só para aquela execução.
# APOLO_AUTODEV=0

# Modelo, esforço e limites do agente que altera o código.
# APOLO_AUTODEV_MODELO=claude-opus-5
# APOLO_AUTODEV_ESFORCO=high
# APOLO_AUTODEV_TURNOS=80
# APOLO_AUTODEV_ORCAMENTO_USD=10
# APOLO_AUTODEV_LIMITE_MIN=30

# Abrir a cópia de trabalho no VS Code, numa instância própria. 1 liga.
# APOLO_AUTODEV_VSCODE=1
# Fase atual das branches novas (ADR 0016). Mude só ao trocar de fase: com 3, a
# próxima branch é fase-3/nome e a seguinte, fase-3.1/nome.
# APOLO_AUTODEV_FASE=2
# APOLO_VSCODE_BIN=

# Onde ficam as cópias de trabalho e o histórico. Padrão: ~/.apolo/autodev
# APOLO_AUTODEV_PASTA=


# ===================================================================
# INTERFACE (Vite)
# ===================================================================
# Onde a ponte escuta.
# VITE_BRIDGE_URL=wss://localhost:8787

# ── Celular (ADR 0019) ───────────────────────────────────────────────────────
# Quem fala com o gateway do app. Não preencha à mão: `npm run celular` gera o
# token e publica a porta no Tailscale. Sem token, a porta nem abre.
# APOLO_GATEWAY_TOKEN=
# APOLO_GATEWAY_PORT=8788
# APOLO_GATEWAY_HOST=127.0.0.1

# Latência no celular (docs/adr/0020). Vazio usa o padrão.
# APOLO_CELULAR_SILENCIO_MS=700
# APOLO_CELULAR_ESFORCO=low

# HTTPS (docs/adr/0021). Por padrão, usa o certificado de ~/.apolo/tls (npm run https).
# Num servidor de verdade, aponte para um certificado real:
# APOLO_TLS_CERT=
# APOLO_TLS_KEY=


# ===================================================================
# F.Ê.N.I.X. E H.E.R.M.E.S. — docs/adr/0025
# ===================================================================
# A Fênix (npm start) passa FENIX_URL e FENIX_TOKEN à ponte; não preencha à mão
# para uso local. O token fica em ~/.apolo/fenix/token. Para outra máquina, aponte
# a ponte para ela e copie o token.
# FENIX_URL=wss://localhost:8790/fenix
# FENIX_TOKEN=
# FENIX_PORTA=8790
# FENIX_HOST=127.0.0.1
# FENIX_PASTA=
# Autoridade do certificado da Fênix, se não for o certificado local.
# FENIX_CA=

# O token entre o H.E.R.M.E.S. e a ponte. Vazio: os dois derivam o mesmo do
# APOLO_GATEWAY_TOKEN, e o pareamento atual continua valendo.
# APOLO_HERMES_TOKEN=
# Onde o H.E.R.M.E.S. encontra a ponte, se estiver em outra máquina.
# HERMES_APOLO_URL=wss://localhost:8787

# ===================================================================
# A.U.R.O.R.A. — o bom dia (docs/adr/0026)
# ===================================================================
# Quem pode pedir o bom dia. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APOLO_AURORA_TOKEN=
# APOLO_AURORA_URL=https://localhost:8791
# Link .ics da agenda publicada no Outlook.com (Configurações → Calendário →
# Calendários compartilhados → Publicar). Quem tem o link lê a agenda.
# APOLO_AGENDA_ICS=
# Cliente OAuth do Google Cloud, tipo "TVs e dispositivos de entrada limitados",
# com a YouTube Data API v3 ativada. Depois: npm run aurora:autorizar
# APOLO_GOOGLE_CLIENT_ID=
# APOLO_GOOGLE_CLIENT_SECRET=

# Notificações (docs/adr/0027): quem pode pedir ao H.E.R.M.E.S., o tópico do ntfy
# (assine no app ntfy do iPhone; o nome é o segredo) e o endereço do H.E.R.M.E.S.
# no Tailscale, para os botões. Gere o token e o tópico com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# APOLO_NOTIFICAR_TOKEN=
# APOLO_NTFY_TOPICO=apolo-<algo aleatório>
# APOLO_HERMES_URL_PUBLICA=https://<seu-mac>.<tailnet>.ts.net

# O iPhone da rotina app_iphone. Vazio: o primeiro que o devicectl enxergar.
# APOLO_IPHONE_ID=
